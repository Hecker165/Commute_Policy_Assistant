# Copy to .env (or export) to override defaults. Every value has a working
# default; nothing here is required for a local run. Never commit real secrets.
# (.env is git-ignored; env vars always win over .env values.)

# --- LLM --------------------------------------------------------------------
# Local + free by default: Ollama (downloaded into .runtime/ by the start script).
#LLM_PROVIDER=ollama
#LLM_MODEL=llama3.2:3b
#OLLAMA_BASE_URL=http://127.0.0.1:11434

# Hosted alternative: Google Gemini via its OpenAI-compatible endpoint
# (free tier key from https://aistudio.google.com/apikey).
# Create a .env with these lines and run start.bat / ./start.sh as usual:
#LLM_PROVIDER=openai
#OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#GOOGLE_API_KEY=AIza...            # or GEMINI_API_KEY / OPENAI_API_KEY
#LLM_MODEL=gemini-2.0-flash

# Any other OpenAI-compatible provider (e.g. Groq) works the same way:
#OPENAI_BASE_URL=https://api.groq.com/openai/v1
#OPENAI_API_KEY=gsk_...

# --- retrieval ----------------------------------------------------------------
# semantic (default; Chroma ONNX MiniLM-L6-v2) | hybrid (bonus: + BM25-lite rank fusion)
#RETRIEVAL_MODE=semantic
#RETRIEVAL_K=4
#RETRIEVAL_MIN_SIMILARITY=0.30
# deterministic hashed-ngram embeddings for offline/CI runs (no model download)
#EMBEDDING_PROVIDER=hash

# --- budgets -------------------------------------------------------------------
#REQUEST_BUDGET_S=2.7
#LLM_TIMEOUT_S=2.2
#LLM_MAX_TOKENS=220

# --- auth -----------------------------------------------------------------------
#JWT_SECRET=only-for-tests-or-dev   # otherwise a random secret is generated at DATA_DIR/jwt_secret
#TOKEN_TTL_S=28800

# --- storage ----------------------------------------------------------------------
#DATA_DIR=./data/runtime
#POLICIES_DIR=./data/policies

# --- misc ---------------------------------------------------------------------------
#LOG_LEVEL=INFO
