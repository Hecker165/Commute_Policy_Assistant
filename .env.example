# Copy to .env (or export) to override defaults. Every value has a working
# default; nothing here is required for a local run. Never commit real secrets.

# --- LLM ------------------------------------------------------------------
# ollama (default, local + free) | extractive (deterministic fallback, no model) | openai (Groq etc.)
#LLM_PROVIDER=ollama
#LLM_MODEL=llama3.2:3b
#OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional hosted provider (free tier). Key is read from the env only.
#LLM_PROVIDER=openai
#OPENAI_BASE_URL=https://api.groq.com/openai/v1
#OPENAI_API_KEY=

# --- retrieval --------------------------------------------------------------
# semantic (default; Chroma ONNX MiniLM-L6-v2) | hybrid (bonus: + BM25-lite rank fusion)
#RETRIEVAL_MODE=semantic
#RETRIEVAL_K=4
#RETRIEVAL_MIN_SIMILARITY=0.30
# deterministic hashed-ngram embeddings for offline/CI runs (no model download)
#EMBEDDING_PROVIDER=hash

# --- budgets ----------------------------------------------------------------
#REQUEST_BUDGET_S=2.7
#LLM_TIMEOUT_S=2.2
#LLM_MAX_TOKENS=220

# --- auth -------------------------------------------------------------------
#JWT_SECRET=only-for-tests-or-dev   # otherwise a random secret is generated at DATA_DIR/jwt_secret
#TOKEN_TTL_S=28800

# --- storage -----------------------------------------------------------------
#DATA_DIR=./data/runtime
#POLICIES_DIR=./data/policies

# --- misc ---------------------------------------------------------------------
#LOG_LEVEL=INFO
